// Esquema de base de datos por consultorio (Documento 03 §3: una base de
// datos Postgres separada por consultorio, mismo esquema para todas).
//
// Fase 0 — Fundaciones: Usuario (roles y acceso) y BitacoraAuditoria
// (transversal desde el inicio, RF-080/081).
//
// Fase 1 — Núcleo: Pacientes y Agenda (Documento 03 §5): Paciente,
// TipoConsulta (catálogo, RF-028), HorarioMedico (RF-029b) y Cita
// (RF-029a, crear/reprogramar/cancelar). El SRS (Documento 04) remite el
// detalle de estos módulos a los RF-010..015 y RF-020..027 "sin cambios
// respecto a v0.1" — ese archivo v0.1 no está en docs/, así que estos
// modelos se diseñaron con lo explícito en Documento 03/04 (flujo del
// consultorio §2, RF-028/029/029a/029b, diccionario de datos §6) más
// criterio estándar de agenda clínica donde faltó detalle. Revisar contra
// el v0.1 original si aparece.
//
// Fase 2 — Turnos (Documento 03 §5): Turno (RF-030..039, RF-035/035a-e) y
// ListaEspera (RF-035c, diccionario §6.5a). El diccionario §6.6 pone
// `monto_a_cobrar` (RF-038) como campo de la entidad Consulta — pero
// Consulta (nota clínica con diagnóstico/NOM-004) es de Fase 4 y no se
// adelanta aquí. Se pone `montoACobrar` directo en Turno: RF-038 solo pide
// que el médico lo registre "al finalizar la consulta" (la visita, en
// sentido coloquial), no que exista ya el expediente clínico. Revisar si
// conviene migrarlo a Consulta cuando llegue Fase 4.
//
// Consulta (nota clínica), CatalogoMedicamento y ConversacionWhatsApp
// llegan en las fases donde el SRS los introduce.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexión agrupada (pgbouncer, puerto 6543) — la usa la app en runtime.
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432) — Prisma la necesita para migraciones;
  // `prisma migrate` no funciona de forma confiable a través de pgbouncer.
  directUrl = env("DIRECT_URL")
}

// Roles definidos en Documento 04 §5 (tabla de permisos).
enum Rol {
  MEDICO
  RECEPCION
  ADMIN
}

// El id coincide con el uid de Supabase Auth (auth.users.id) — se crea la
// fila en esta tabla justo después del alta en Supabase Auth, nunca antes
// (ver src/lib/supabase y la nota en README sobre alta de usuarios).
model Usuario {
  id            String   @id
  nombre        String
  email         String   @unique
  rol           Rol
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  bitacora         BitacoraAuditoria[]
  horarios         HorarioMedico[]
  citasComoMedico  Cita[]              @relation("CitasMedico")
  citasCreadas     Cita[]              @relation("CitasCreadas")
  turnosComoMedico Turno[]             @relation("TurnosMedico")

  @@map("usuarios")
}

// RF-080/081 (Documento 04 §3.9) + diccionario de datos §6.8.
// Retención mínima de 5 años (RNF-03a) — se administra a nivel de política
// de base de datos / backups, no de borrado aplicativo.
model BitacoraAuditoria {
  id              String   @id @default(cuid())
  usuarioId       String
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  accion          String
  entidadAfectada String?
  fechaHora       DateTime @default(now())

  @@index([usuarioId])
  @@index([fechaHora])
  @@map("bitacora_auditoria")
}

// Datos administrativos del paciente (Documento 04 §5: visibles para
// Médico/Recepción/Admin). El historial clínico (diagnóstico, notas,
// tratamiento) NO vive aquí — llega en Fase 4 como parte de la entidad
// Consulta, con permisos distintos (solo médicos).
model Paciente {
  id              String    @id @default(cuid())
  nombre          String
  apellidos       String
  telefono        String
  fechaNacimiento DateTime?
  notas           String?
  activo          Boolean   @default(true)
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt

  citas       Cita[]
  turnos      Turno[]
  listaEspera ListaEspera[]

  @@index([nombre, apellidos])
  @@map("pacientes")
}

// Catálogo de tipos de servicio agendable (RF-028, diccionario §6.3a).
// "Aplicación" (requiereAgenda = false) no se agenda — se atiende por orden
// de llegada (RF-039, regla de los 30 minutos en Fase 2) — se deja en el
// catálogo desde ahora porque es parte del mismo diccionario de datos,
// aunque su flujo de turnos todavía no está implementado.
model TipoConsulta {
  id             String  @id @default(cuid())
  nombre         String
  duracionMin    Int
  requiereAgenda Boolean @default(true)

  citas Cita[]

  @@map("tipos_consulta")
}

// RF-029b: horario laboral del médico, con patrones distintos por grupo de
// días (ej. Lun/Mié/Vie 11:00-14:00 y 17:00-20:40; Mar/Jue/Sáb 11:00-14:00
// y 17:00-19:00) — cada franja es una fila.
model HorarioMedico {
  id         String  @id @default(cuid())
  medicoId   String
  medico     Usuario @relation(fields: [medicoId], references: [id])
  diaSemana  Int // 0 = domingo … 6 = sábado
  horaInicio String // "HH:MM", 24h
  horaFin    String // "HH:MM", 24h

  @@index([medicoId])
  @@map("horarios_medico")
}

enum EstadoCita {
  AGENDADA
  CONFIRMADA
  REPROGRAMADA
  CANCELADA
  COMPLETADA
  NO_ASISTIO
}

// RF-029a: la agenda se consulta de forma nativa en AGENDAM. RF-028: crear,
// reprogramar, cancelar citas; estados de cita.
model Cita {
  id              String       @id @default(cuid())
  pacienteId      String
  paciente        Paciente     @relation(fields: [pacienteId], references: [id])
  medicoId        String
  medico          Usuario      @relation("CitasMedico", fields: [medicoId], references: [id])
  tipoConsultaId  String
  tipoConsulta    TipoConsulta @relation(fields: [tipoConsultaId], references: [id])
  fechaHoraInicio DateTime
  fechaHoraFin    DateTime
  estado          EstadoCita   @default(AGENDADA)
  notas           String?
  creadoPorId     String?
  creadoPor       Usuario?     @relation("CitasCreadas", fields: [creadoPorId], references: [id])
  creadoEn        DateTime     @default(now())
  actualizadoEn   DateTime     @updatedAt

  turno Turno?

  @@index([medicoId, fechaHoraInicio])
  @@index([pacienteId])
  @@map("citas")
}

enum TipoTurno {
  CITA_AGENDADA
  // RF-039: 5 min, no se agenda — se atiende por orden de llegada con la
  // regla de los 30 minutos (RF-035a).
  APLICACION
  // RF-035b: paciente llega sin cita pidiendo consulta regular y se le da
  // lugar el mismo día. No está en el diccionario original (§6.5 solo
  // enumera cita_agendada/aplicacion) — se agrega para distinguirlo de
  // APLICACION, que tiene su propia regla de inserción distinta.
  SIN_CITA
}

enum EstadoTurno {
  EN_ESPERA
  EN_ATENCION
  COMPLETADO
  CANCELADO
  NO_ASISTIO
}

// RF-030..039: registro de llegada, turno y cola de espera por médico.
// Diccionario §6.5: `tipo` y `horaInicioEspera` (para la regla de los 30
// minutos, RF-035a) son los campos que ese diccionario agrega sobre un
// Turno base de v0.1 que no está disponible — el resto de los campos se
// diseñó con criterio estándar de sala de espera clínica.
model Turno {
  id                 String      @id @default(cuid())
  pacienteId         String
  paciente           Paciente    @relation(fields: [pacienteId], references: [id])
  medicoId           String
  medico             Usuario     @relation("TurnosMedico", fields: [medicoId], references: [id])
  citaId             String?     @unique
  cita               Cita?       @relation(fields: [citaId], references: [id])
  tipo               TipoTurno
  estado             EstadoTurno @default(EN_ESPERA)
  horaLlegada        DateTime    @default(now())
  horaInicioEspera   DateTime    @default(now())
  horaInicioAtencion DateTime?
  horaFinAtencion    DateTime?
  // RF-038/038a: lo registra el médico al finalizar, lo consulta recepción.
  montoACobrar       Decimal?    @db.Decimal(10, 2)
  creadoEn           DateTime    @default(now())
  actualizadoEn      DateTime    @updatedAt

  @@index([medicoId, estado])
  @@index([pacienteId])
  @@map("turnos")
}

enum EstatusListaEspera {
  EN_ESPERA
  ASIGNADA
  CANCELADA
}

// RF-035c: pacientes con consultas cortas conocidas que el médico puede
// atender entre pacientes agendados — distinto del flujo de Turno. RF-035d
// (ofrecer automáticamente el lugar liberado por una cancelación) no se
// automatiza en esta fase: requeriría un canal de notificación que todavía
// no existe (WhatsApp llega en Fase 3) — por ahora la reasignación es
// manual (recepción marca ASIGNADA a mano).
model ListaEspera {
  id            String             @id @default(cuid())
  pacienteId    String
  paciente      Paciente           @relation(fields: [pacienteId], references: [id])
  motivo        String
  fechaRegistro DateTime           @default(now())
  estatus       EstatusListaEspera @default(EN_ESPERA)

  @@index([estatus])
  @@map("lista_espera")
}
