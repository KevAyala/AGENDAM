# Copia este archivo a .env.local (Next.js) y a .env (Prisma CLI) y llena
# los valores reales. Nunca se commitea .env / .env.local (ver .gitignore).

# --- Base de datos del consultorio (Prisma) --------------------------------
# Documento 03 §3: cada consultorio tiene su propia base de datos — estos
# valores cambian por despliegue, no se comparten entre consultorios.
# Ambos salen de Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL: conexión agrupada (pooler / pgbouncer), puerto 6543 — la usa
# la app en runtime (Vercel abre muchas conexiones cortas; sin pooler se agotan).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres?pgbouncer=true"
# DIRECT_URL: conexión directa, puerto 5432 — solo la usa `prisma migrate`.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres"

# --- Supabase Auth (proyecto del mismo consultorio) -------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]" # solo servidor, nunca exponer al cliente
