# Copia este archivo a .env.local (Next.js) y a .env (Prisma CLI) y llena
# los valores reales. Nunca se commitea .env / .env.local (ver .gitignore).

# --- Base de datos del consultorio (Prisma) --------------------------------
# Connection string de Postgres del proyecto Supabase de ESTE consultorio.
# Documento 03 §3: cada consultorio tiene su propia base de datos — este
# valor cambia por despliegue, no es compartido entre consultorios.
DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# --- Supabase Auth (proyecto del mismo consultorio) -------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]" # solo servidor, nunca exponer al cliente
