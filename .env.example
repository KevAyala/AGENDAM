# Copia este archivo a .env.local (Next.js) y a .env (Prisma CLI) y llena
# los valores reales. Nunca se commitea .env / .env.local (ver .gitignore).

# --- Base de datos del consultorio (Prisma) --------------------------------
# Documento 03 §3: cada consultorio tiene su propia base de datos — estos
# valores cambian por despliegue, no se comparten entre consultorios.
# Ambos salen de Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL: conexión agrupada (pooler / pgbouncer), puerto 6543 — la usa
# la app en runtime (Vercel abre muchas conexiones cortas; sin pooler se agotan).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres?pgbouncer=true"
# DIRECT_URL: conexión directa, puerto 5432 — solo la usa `prisma migrate`.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres"

# --- Supabase Auth (proyecto del mismo consultorio) -------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]" # solo servidor, nunca exponer al cliente

# --- WhatsApp / Twilio (Fase 3, confirmaciones de cita) ---------------------
# Consola de Twilio → Account → API keys & tokens.
TWILIO_ACCOUNT_SID="[account-sid]"
TWILIO_AUTH_TOKEN="[auth-token]" # también valida la firma del webhook entrante
# Mientras se prueba: número del WhatsApp Sandbox de Twilio (fijo, no es el
# número real de la farmacia — ver nota de alcance en src/lib/whatsapp.ts).
# Cada destinatario de prueba debe mandarle "join <código>" una vez desde su
# WhatsApp antes de poder recibir mensajes.
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Nombre del consultorio, se usa en la plantilla del mensaje de confirmación.
CONSULTORIO_NOMBRE="[nombre del consultorio]"
# Protege /api/whatsapp/enviar-confirmaciones: Vercel Cron manda este valor
# automáticamente como "Authorization: Bearer <CRON_SECRET>" si la variable
# está configurada en el proyecto de Vercel. Cualquier string largo sirve
# (ej. genera uno con `openssl rand -hex 32`); déjalo vacío en local si solo
# vas a probar la ruta a mano.
CRON_SECRET="[secreto-largo-aleatorio]"
